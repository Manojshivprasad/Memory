# Copy to .env and adjust. All settings use the MEMORY_ prefix (see app/config.py).
MEMORY_DATABASE_URL=postgresql+asyncpg://memory_app:memory_app@localhost:5433/memory
MEMORY_DATABASE_ADMIN_URL=postgresql+asyncpg://memory:memory@localhost:5433/memory
MEMORY_REDIS_URL=redis://localhost:6380/0
MEMORY_JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes

# fastembed (local ONNX, default) or hash (deterministic, tests only)
MEMORY_EMBEDDER=fastembed

# Internal model for extraction / consolidation (LiteLLM model string); empty = heuristic mode (no LLM calls).
MEMORY_LLM_MODEL=groq/openai/gpt-oss-120b
# Faster model for the latency-bound memory agent (defaults to MEMORY_LLM_MODEL).
MEMORY_AGENT_LLM_MODEL=groq/openai/gpt-oss-20b
# Provider keys are read by LiteLLM from the standard env vars (this file is loaded into the environment):
# GROQ_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
